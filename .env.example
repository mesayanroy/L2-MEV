# ============================================================
# L2-MEV Shield — Environment Variables Template
# Copy to .env and fill in your values. NEVER commit .env.
# ============================================================

# ── Backend ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Solana RPC (use a premium endpoint in production)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Jito block-engine endpoint for private bundle submission
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_AUTH_KEYPAIR_PATH=./keys/jito-auth.json

# JWT secret for API authentication (min 32 chars)
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Rate-limiting Redis (optional; falls back to in-memory)
REDIS_URL=redis://localhost:6379

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://l2mev.io

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ── CLI ──────────────────────────────────────────────────────
# These are stored in ~/.l2mev/config.json after `l2mev init`
# L2MEV_RPC_URL=
# L2MEV_KEYPAIR_PATH=
# L2MEV_API_KEY=
